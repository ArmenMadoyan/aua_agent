# ─── Required ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...your-key-here...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aua_agent

# ─── Optional (defaults shown) ──────────────────────────────
# EMBEDDING_DIMENSION=1536
# DEFAULT_USER_ID=1
# GRADING_VISION_MODEL=gpt-4o

# ─── Docker / Production overrides ──────────────────────────
# When running via docker-compose, the DATABASE_URL should point
# to the service name instead of localhost:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/aua_agent

# ─── FastAPI ─────────────────────────────────────────────────
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000

# ─── Streamlit ───────────────────────────────────────────────
# STREAMLIT_SERVER_PORT=8501
# STREAMLIT_SERVER_ADDRESS=0.0.0.0
